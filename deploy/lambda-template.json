{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Beginner Companion stateless Lambda staging API; no always-on compute.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "ArtifactKey": {
      "Type": "String"
    },
    "FunctionName": {
      "Type": "String",
      "Default": "beginner-companion-staging"
    },
    "ReservedConcurrency": {
      "Type": "Number",
      "Default": 2,
      "MinValue": 1,
      "MaxValue": 5
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${FunctionName}"
        },
        "RetentionInDays": 7
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WriteOwnLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Planner": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": [
        "Logs"
      ],
      "Properties": {
        "FunctionName": {
          "Ref": "FunctionName"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "beginner_companion.api.lambda_handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 8,
        "ReservedConcurrentExecutions": {
          "Ref": "ReservedConcurrency"
        },
        "Environment": {
          "Variables": {
            "COMPANION_ENV": "production"
          }
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        }
      }
    },
    "Url": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Planner"
        },
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED"
      },
      "DependsOn": [
        "UrlPermission",
        "InvokePermission"
      ]
    },
    "UrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Planner"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Planner"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    }
  },
  "Outputs": {
    "PlannerUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Url",
          "FunctionUrl"
        ]
      }
    }
  }
}
