          },
          "title": "Skill Xp",
          "type": "object"
        },
        "skill_levels": {
          "$ref": "#/$defs/GoalSkills"
        },
        "quest_progress": {
          "$ref": "#/$defs/GoalQuests"
        },
        "members": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Members"
        },
        "quest_points": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quest Points"
        },
        "ardougne_easy_tasks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
