{
  "$defs": {
    "CompletionEvent": {
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Goal Id",
          "type": "string"
        },
        "completed_at": {
          "maximum": 253402300799,
          "minimum": 0,
          "title": "Completed At",
          "type": "integer"
        }
      },
      "required": [
        "goal_id",
        "completed_at"
      ],
      "title": "CompletionEvent",
      "type": "object"
    },
    "GoalAccount": {
      "additionalProperties": false,
      "properties": {
        "skill_xp": {
          "additionalProperties": {
            "maximum": 200000000,
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "attack",
              "defence",
              "strength",
              "hitpoints",
              "ranged",
              "prayer",
              "magic",
              "cooking",
              "woodcutting",
              "fletching",
              "fishing",
              "firemaking",
              "crafting",
              "smithing",
              "mining",
              "herblore",
