  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "title": "Protocol Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "goal_id": {
      "const": "all",
      "default": "all",
      "title": "Goal Id",
      "type": "string"
    },
    "account": {
      "$ref": "#/$defs/GoalAccount"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "source": {
      "default": "demo",
      "enum": [
        "demo",
        "live"
      ],
      "title": "Source",
      "type": "string"
    },
    "completion_history": {
      "items": {
        "$ref": "#/$defs/CompletionEvent"
      },
      "maxItems": 50,
      "title": "Completion History",
      "type": "array"
    },
    "recommendation_feedback": {
      "maxProperties": 100,
      "patternProperties": {
        "^[a-z0-9_]{1,128}$": {
          "$ref": "#/$defs/GoalFeedback"
        }
      },
      "title": "Recommendation Feedback",
      "type": "object"
    }
