            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "required": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Required"
